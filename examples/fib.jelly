/* Print the first fibonacci numbers as ASCII digits (single-digit only). */
int putchar(int);

int main()
{
  int a;
  int b;
  int c;
  int i;
  a = 0;
  b = 1;
  i = 0;
  while (i <= 6) {
    putchar('0' + a);
    putchar(10);
    c = a + b;
    a = b;
    b = c;
    i = i + 1;
  }
  return 0;
}
